# --- Claude (Anthropic) ---------------------------------------------------
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: model override (default: claude-haiku-5-5, the cheapest Claude model)
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Arize Phoenix tracing ---------------------------------------------------
PHOENIX_TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=travel-agent

# --- Evaluation ---------------------------------------------------------------
# Optional: model for the LLM-as-a-judge evaluators (default: claude-haiku-5-5)
# JUDGE_MODEL=claude-haiku-5-5
